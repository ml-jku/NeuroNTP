#!/bin/sh
# Build and runtime environment for the CUDA extensions (xLSTM sLSTM kernels, mamba-ssm).
# Source once per shell after activating the conda environment:  . ./nntp.env
# Adjust TORCH_CUDA_ARCH_LIST to the compute capabilities of the GPUs in use.

export CUDA_HOME="$CONDA_PREFIX"
export CPATH="$CONDA_PREFIX/targets/x86_64-linux/include:${CPATH:-}"
export CPLUS_INCLUDE_PATH="$CONDA_PREFIX/targets/x86_64-linux/include:${CPLUS_INCLUDE_PATH:-}"
export LIBRARY_PATH="$CONDA_PREFIX/lib:${LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export TORCH_CUDA_ARCH_LIST="8.0;8.6;9.0"

# Optional, for clusters with a home directory shared across nodes (e.g. NFS): keep compiled CUDA extensions
# and caches per host, to avoid conflicts between nodes and lock files on network file systems.
# HOST=$(hostname -s)
# export TORCH_EXTENSIONS_DIR="/tmp/torch_ext_${USER}_${HOST}"
# export XDG_CACHE_HOME="/tmp/xdg_cache_${USER}_${HOST}"
# export CUDA_CACHE_PATH="/tmp/cuda_cache_${USER}_${HOST}"
# mkdir -p "$TORCH_EXTENSIONS_DIR" "$XDG_CACHE_HOME" "$CUDA_CACHE_PATH"

# Optional, for compute nodes without internet access: use the locally cached Hugging Face models only
# (download the marker encoder once beforehand on a node with internet access).
# export HF_HUB_OFFLINE=1